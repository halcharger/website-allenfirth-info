{
  "trailingSlash": "auto",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.css",
      "/*.js",
      "/*.ico",
      "/*.svg",
      "/*.pdf",
      "/*.xml",
      "/*.txt",
      "/*.png",
      "/*.jpg",
      "/*.webp",
      "/*.webmanifest"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff"
  }
}
